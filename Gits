# Start from an updated main branch
git switch main
git pull origin main

# Create your working branch
git switch -c RedundancyAnalysis

# Make your changes, then commit and push
git add .
git commit -m "Add redundancy analysis"
git push -u origin RedundancyAnalysis

# Create the merge request
glab mr create --fill --target-branch main

# If GitLab reports conflicts
git fetch origin
git merge origin/main

# Keep your branch's version for all conflicting files
git checkout --ours .
git add .
git commit -m "Resolve merge conflicts using RedundancyAnalysis changes"
git push

# After checks and approvals
glab mr merge --remove-source-branch
